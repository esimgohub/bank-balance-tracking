# Application
APP_NAME=bank-balance-tracking
LOG_LEVEL=INFO
TIMEZONE=Asia/Ho_Chi_Minh
CRON_EXPRESSION=0 8,17 * * *
SCHEDULER_ENABLED=true

# Trigger behavior
# true: POST /bank_tracking returns 202 immediately and runs in background (in-process/in-memory;
#       accepted/in-flight work can be lost on restart; concurrent runs are rejected with 409).
# false: POST /bank_tracking waits for job completion and returns the run result.
WEBHOOK_IMMEDIATE_RESPONSE=true

# Feature flags / scope
BIDV_ENABLED=false
BIDV_SKIP_DISCLOSURE=NOTICE: BIDV balances (8699888886, 8680063639, 8650119871) are temporarily excluded. The total below DOES NOT include BIDV accounts.

# Enterprise balance source
ENTERPRISE_BALANCE_URL=https://6ohzqc2srk.execute-api.ap-southeast-1.amazonaws.com/dev/check-bank-account-balance
ENTERPRISE_TIMEOUT_SECONDS=30

# Lark
LARK_TOKEN_URL=https://open.larksuite.com/open-apis/auth/v3/tenant_access_token/internal
LARK_MESSAGE_URL=https://open.larksuite.com/open-apis/message/v4/send/
LARK_APP_ID=
LARK_APP_SECRET=
LARK_CHAT_ID=

# HTTP behavior (no automatic retries per current decision)
HTTP_TIMEOUT_SECONDS=30
